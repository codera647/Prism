# Optional settings are read from the process environment (no dotenv dependency).
PRISM_DATA_DIR=.prism
PRISM_HOST=127.0.0.1
PRISM_PORT=8000
# Set true only behind an HTTPS reverse proxy; local mode uses HTTP.
PRISM_SECURE_COOKIE=false
PRISM_ORIGIN=http://127.0.0.1:8000

# Cloudflare production setup (scripts/configure_cloud_accounts.py).
# Leave blank in source control; set real values privately in process environment.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base64url encoding of exactly 32 random bytes; retain securely for recovery.
VAULT_KEY=
# Optional comma-separated pilot invitation list. MAX_USERS is capped at 30.
ALLOWED_EMAILS=
